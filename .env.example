# Copy this file to ".env" and fill it in. Never share or upload the .env file.

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/dilena
# Or MongoDB Atlas (free cloud database), for example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dilena

PORT=3000

# true = reviews appear immediately, false = you approve each review first
AUTO_APPROVE=true

# A long secret password for the admin routes (hide / delete reviews)
ADMIN_KEY=change-this-to-a-long-random-text